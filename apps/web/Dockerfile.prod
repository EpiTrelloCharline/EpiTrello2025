# ===========================================
# Stage 1: Dependencies (Base)
# ===========================================
FROM node:20-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.1.0 --activate

# Set working directory
WORKDIR /app

# ===========================================
# Stage 2: Dependencies & Build
# ===========================================
FROM base AS builder

WORKDIR /app

# Copy package files for dependency installation
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/validation/package.json ./packages/validation/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/validation ./packages/validation
COPY apps/web ./apps/web

# Build validation package first
WORKDIR /app/packages/validation
RUN pnpm build || true

# Build the Next.js application
WORKDIR /app/apps/web

# Set Next.js telemetry off
ENV NEXT_TELEMETRY_DISABLED=1

# Build arguments for environment variables at build time
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_WS_URL=

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}

RUN pnpm build

# ===========================================
# Stage 3: Production
# ===========================================
FROM node:20-alpine AS production

# Add labels for better maintainability
LABEL maintainer="EpiTrello Team"
LABEL version="1.0.0"
LABEL description="EpiTrello Web Production Image"

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

WORKDIR /app

# Copy built Next.js application (standalone output)
COPY --from=builder /app/apps/web/.next/standalone ./

# The standalone symlinks point to ../../../node_modules/.pnpm which means /node_modules/.pnpm
# So we need to copy the pnpm store to the root level
COPY --from=builder /app/node_modules/.pnpm /node_modules/.pnpm

# Copy static files
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static

# Copy public folder if exists (optional)
# COPY --from=builder /app/apps/web/public ./apps/web/public

# Set ownership
RUN chown -R nextjs:nodejs /app

# Switch to non-root user
USER nextjs

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

# Expose the web port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000 || exit 1

# Start the application (standalone mode generates server.js at root)
CMD ["node", "server.js"]
