# ===========================================
# EpiTrello Production Environment Variables
# ===========================================
# Copy this file to .env.prod and fill in your values
# NEVER commit .env.prod to version control!

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=trello
POSTGRES_PASSWORD=trello_prod_secure_2025
POSTGRES_DB=trello

# ===========================================
# Redis Configuration
# ===========================================
REDIS_PASSWORD=redis_prod_secure_2025

# ===========================================
# JWT Authentication
# ===========================================
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=epitrello_jwt_secret_key_very_long_and_secure_for_production_2025_minimum_64_chars
JWT_EXPIRATION=24h

# ===========================================
# CORS Configuration
# ===========================================
# Your production domain (without trailing slash)
CORS_ORIGIN=http://localhost

# ===========================================
# API Configuration
# ===========================================
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=wss://your-domain.com

# ===========================================
# File Upload Configuration
# ===========================================
# Max file size in bytes (default: 10MB = 10485760)
MAX_FILE_SIZE=10485760

# ===========================================
# Server Ports (for host machine)
# ===========================================
HTTP_PORT=80
HTTPS_PORT=443

# ===========================================
# Optional: Email Configuration
# ===========================================
# SMTP_HOST=smtp.your-email-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@your-domain.com

# ===========================================
# Optional: Logging
# ===========================================
# LOG_LEVEL=info

# ===========================================
# Optional: SSL Configuration
# ===========================================
# SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem
