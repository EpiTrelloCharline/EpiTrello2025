# ===========================================
# Docker Ignore File for EpiTrello
# ===========================================

# Dependencies
node_modules
**/node_modules

# Build outputs
dist
**/dist
.next
**/.next
out
**/out

# Development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (use Docker secrets or env vars)
.env
.env.*
!.env.example
!.env.prod.example

# IDE and editor files
.idea
.vscode
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# Test files
**/*.test.ts
**/*.spec.ts
**/test
**/tests
**/__tests__
**/e2e
coverage
**/coverage
playwright-report
test-results

# Documentation
*.md
docs
!README.md

# Misc
*.tsbuildinfo
.eslintcache
.prettiercache
